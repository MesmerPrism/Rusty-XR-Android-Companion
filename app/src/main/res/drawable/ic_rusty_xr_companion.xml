<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5F0E3" />
            <stroke
                android:width="2dp"
                android:color="#1A1E28" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:left="18dp"
        android:top="18dp"
        android:right="18dp"
        android:bottom="18dp">
        <shape android:shape="oval">
            <solid android:color="#DF2C2C" />
            <stroke
                android:width="2dp"
                android:color="#8F1717" />
        </shape>
    </item>
</layer-list>

